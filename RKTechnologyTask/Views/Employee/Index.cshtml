@model List<EmployeeListModel>

<body class="bg-white">
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-12">

                            <div class="card shadow-lg border-0 rounded-lg mt-3">

                         
                                <div class="card-header bg-black text-white d-flex justify-content-between align-items-center">
                                    <h3 class="mb-0">Employee List</h3>
                                    <a asp-action="CreateEmployee" class="btn btn-success">Add</a>
                                </div>

                        
                                <div class="card-body">

                           
                                    <div class="row mb-3">
                                        <div class="col-md-4 d-flex gap-2">
                                            <input type="text" id="searchText" class="form-control" placeholder="Search..." />
                                        
                                        </div>
                                    </div>

                                    <table id="empTable" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Mobile</th>
                                                <th>DOB</th>
                                                <th>Country</th>
                                                <th>State</th>
                                                <th>City</th>
                                                <th>Hobbies</th>
                                                <th>Gender</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.EmployeeName</td>
                                                    <td>@item.Email</td>
                                                    <td>@item.MobileNumber</td>
                                                    <td>@item.DOB.ToString("dd-MM-yyyy")</td>
                                                    <td>@item.CountryName</td>
                                                    <td>@item.StateName</td>
                                                    <td>@item.CityName</td>
                                                    <td>@item.Hobbies</td>
                                                    <td>@item.Gendar</td>
                                                    <td>
                                                        <a asp-action="GeyById" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-warning">Edit</a>
                                                        <a asp-action="SoftDetele" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-danger">Delete</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function searchData() {

        var search = $("#searchText").val();

        $.ajax({
            url: '/Employee/SearchEmployee',
            type: 'GET',
            data: { search: search },

            success: function (data) {

                var table = $("#empTable tbody");
                table.empty();

                if (data.length === 0) {
                    table.append("<tr><td colspan='10' class='text-center'>No Data Found</td></tr>");
                    return;
                }

                $.each(data, function (i, item) {

                    var row = "<tr>" +
                        "<td>" + item.employeeName + "</td>" +
                        "<td>" + item.email + "</td>" +
                        "<td>" + item.mobileNumber + "</td>" +
                        "<td>" + formatDate(item.dob) + "</td>" +
                        "<td>" + item.countryName + "</td>" +
                        "<td>" + item.stateName + "</td>" +
                        "<td>" + item.cityName + "</td>" +
                        "<td>" + item.hobbies + "</td>" +
                        "<td>" + item.gendar + "</td>" +
                        "<td>" +
                         "<a href='/Employee/GeyById/" + item.employeeId + "' class='btn btn-sm btn-warning'>Edit</a> " +
                         "<a href='/Employee/SoftDetele/" + item.employeeId + "' class='btn btn-sm btn-danger'>Delete</a>" +
                        "</td>" +
                        "</tr>";

                    table.append(row);
                });
            }
        });
    }

    function formatDate(date) {
        var d = new Date(date);
        return d.getDate() + "-" + (d.getMonth() + 1) + "-" + d.getFullYear();
    }

    $("#searchText").keyup(function () {
        searchData();
    });
</script>